# Copy to .env for local use. Never commit the resulting file.
POSTGRES_DB=germany_applications
POSTGRES_USER=germany_app
POSTGRES_PASSWORD=replace-with-a-local-only-password
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=germany_applications;Username=germany_app;Password=replace-with-a-local-only-password"
Cors__AllowedOrigins__0=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# Required outside Development: protected persistent directory for cookie-signing keys.
DataProtection__KeysPath=
